<html><body><script type="text/javascript" src="/cupid.js" ></script><script>function toNumbers(d){var e=[];d.replace(/(..)/g,function(d){e.push(parseInt(d,16))});return e}function toHex(){for(var d=[],d=1==arguments.length&&arguments[0].constructor==Array?arguments[0]:arguments,e="",f=0;f<d.length;f++)e+=(16>d[f]?"0":"")+d[f].toString(16);return e.toLowerCase()}var a=toNumbers("6d254dd26eeac814770ab7dd7e031f62"),b=toNumbers("7ad07b01539713bae823d458faa11c0c"),c=toNumbers("918885159fb178d599c96a5bf3f75ddb");var now=new Date(),time=now.getTime();time+=3600*1000*24;now.setTime(time);document.cookie="CUPID="+toHex(slowAES.decrypt(c,2,a,b))+"; expires="+now.toUTCString()+"; path=/";location.href="https://cityenergylab.cafe24.com/wp-content/uploads/2021/10/Shi_lecture-scaled.jpg?ckattempt=1";</script></body></html>